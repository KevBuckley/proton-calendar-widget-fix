+package me.proton.android.calendar
+
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.appwidget.AppWidgetManager
+import android.widget.RemoteViews
+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import io.mockk.mockk
+import io.mockk.verify
+import org.junit.jupiter.api.Test
+import java.time.Instant
+import java.time.ZoneId
+import java.time.ZonedDateTime
+
+internal class CalendarWidgetTest {
+
+    @Test
+    fun `event list refresh also refreshes header`() {
+        val widgetManager = mockk<AppWidgetManager>(relaxed = true)
+        val remoteViews = mockk<RemoteViews>(relaxed = true)
+        val widgetIds = intArrayOf(4, 8)
+
+        refreshWidgetHeaderAndEventList(widgetManager, widgetIds, remoteViews, "Thursday", "October 29")
+
+        verify { remoteViews.setTextViewText(R.id.tv_header_text, "Thursday") }
+        verify { remoteViews.setTextViewText(R.id.tv_main_text, "October 29") }
+        verify { widgetManager.partiallyUpdateAppWidget(widgetIds, remoteViews) }
+        verify { widgetManager.notifyAppWidgetViewDataChanged(widgetIds, R.id.lv_widget) }
+    }
+
+    @Test
+    fun `next midnight uses the current local time zone across daylight saving change`() {
+        val zone = ZoneId.of("America/New_York")
+        val now = ZonedDateTime.of(2026, 3, 7, 23, 30, 0, 0, zone)
+
+        val scheduled = ZonedDateTime.ofInstant(
+            Instant.ofEpochMilli(nextMidnightMillis(now)),
+            zone
+        )
+
+        assertThat(scheduled).isEqualTo(ZonedDateTime.of(2026, 3, 8, 0, 0, 0, 0, zone))
+    }
+
+    @Test
+    fun `midnight alarm is exact when access is available`() {
+        val alarmManager = mockk<AlarmManager>(relaxed = true)
+        val pendingIntent = mockk<PendingIntent>()
+
+        scheduleMidnightAlarm(alarmManager, pendingIntent, 1234L, canScheduleExactAlarm = true)
+
+        verify { alarmManager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, 1234L, pendingIntent) }
+    }
+
+    @Test
+    fun `midnight alarm falls back when exact alarm access is unavailable`() {
+        val alarmManager = mockk<AlarmManager>(relaxed = true)
+        val pendingIntent = mockk<PendingIntent>()
+
+        scheduleMidnightAlarm(alarmManager, pendingIntent, 1234L, canScheduleExactAlarm = false)
+
+        verify { alarmManager.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, 1234L, pendingIntent) }
+    }
+}

