+        /**
+         * Schedules a one-shot update for the next local midnight. Exact delivery is used when
+         * permitted; otherwise Android may defer the fallback alarm while the device is idle.
+         * Every full widget update schedules the following midnight again.
+         */
+        fun scheduleNextMidnightUpdate(context: Context) {
+            val widgetManager = AppWidgetManager.getInstance(context)
+            val widgetComponent = ComponentName(context, CalendarWidget::class.java)
+            if (widgetManager.getAppWidgetIds(widgetComponent).isEmpty()) return
+
+            val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
+            scheduleMidnightAlarm(
+                alarmManager,
+                createMidnightUpdatePendingIntent(context),
+                nextMidnightMillis(ZonedDateTime.now(ZoneId.systemDefault())),
+                Build.VERSION.SDK_INT < Build.VERSION_CODES.S || alarmManager.canScheduleExactAlarms()
+            )
+        }
+
+        private fun cancelMidnightUpdate(context: Context) {
+            val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
+            alarmManager.cancel(createMidnightUpdatePendingIntent(context))
+        }
+
+        private fun createMidnightUpdatePendingIntent(context: Context): PendingIntent =
+            PendingIntent.getBroadcast(
+                context,
+                MIDNIGHT_UPDATE_REQUEST_CODE,
+                Intent(context, CalendarWidget::class.java).setAction(ACTION_MIDNIGHT_UPDATE),
+                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
+            )
+
     }
 
 }
 
+internal fun nextMidnightMillis(now: ZonedDateTime): Long =
+    now.toLocalDate().plusDays(1).atStartOfDay(now.zone).toInstant().toEpochMilli()
+
+internal fun scheduleMidnightAlarm(
+    alarmManager: AlarmManager,
+    pendingIntent: PendingIntent,
+    triggerAtMillis: Long,
+    canScheduleExactAlarm: Boolean
+) {
+    if (canScheduleExactAlarm) {
+        alarmManager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, triggerAtMillis, pendingIntent)
+    } else {
+        // Best effort without exact-alarm access. Doze and app standby can delay delivery.
+        alarmManager.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, triggerAtMillis, pendingIntent)
+    }
+}
